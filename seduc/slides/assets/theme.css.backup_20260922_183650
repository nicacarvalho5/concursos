/* Tema compartilhado - mira-animator style */
:root {
    --mira-primary: #FF904D;
    --mira-crop: #35D07F;
    --mira-bg: #000000;
    --mira-text: #ffffff;
    --mira-text-soft: rgba(255, 255, 255, 0.70);
    --mira-text-softer: rgba(255, 255, 255, 0.50);
    --mira-card-bg: rgba(255, 255, 255, 0.05);
    --mira-card-border: rgba(255, 255, 255, 0.10);
    --mira-glow-soft: rgba(255, 144, 77, 0.15);
    --mira-glow-strong: rgba(255, 144, 77, 0.25);
    --mira-icon-bg: rgba(255, 144, 77, 0.15);
    --mira-icon-border: rgba(255, 144, 77, 0.30);
    --mira-pill-bg: rgba(255, 255, 255, 0.04);
    --mira-pill-border: rgba(255, 255, 255, 0.08);
    --mira-stage-glow: rgba(255, 144, 77, 0.06);
    --mira-accent-2: #FFC766;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
    background: var(--mira-bg);
    min-height: 100vh;
    color: var(--mira-text);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.7;
}

a { color: var(--mira-primary); text-decoration: none; transition: color 0.2s ease; }
a:hover { color: var(--mira-accent-2); }

/* ===== TIPOGRAFIA DE CONTEÚDO ===== */
article.glass-card,
.content-article {
    max-width: 900px;
    margin: 0 auto;
    padding: 2.5rem;
}

.content-article h1 {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 2.5rem 0 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--mira-card-border);
    background: linear-gradient(90deg, var(--mira-primary), var(--mira-accent-2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.content-article h2 {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 2.5rem 0 1rem;
    color: var(--mira-text);
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.content-article h2::before {
    content: "";
    width: 8px;
    height: 1.2em;
    background: linear-gradient(180deg, var(--mira-primary), var(--mira-accent-2));
    border-radius: 4px;
}

.content-article h3 {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 2rem 0 0.75rem;
    color: var(--mira-primary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.content-article h3::before {
    content: "";
    width: 4px;
    height: 1em;
    background: var(--mira-primary);
    border-radius: 2px;
}

.content-article h4 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 1.5rem 0 0.5rem;
    color: var(--mira-text-soft);
}

.content-article p {
    margin: 1rem 0;
    line-height: 1.8;
    color: var(--mira-text-soft);
}

.content-article strong { color: var(--mira-text); font-weight: 600; }
.content-article em { font-style: italic; color: var(--mira-text-soft); }

.content-article ul,
.content-article ol {
    margin: 1rem 0 1rem 1.5rem;
    line-height: 1.9;
}

.content-article li {
    margin: 0.5rem 0;
    padding-left: 0.25rem;
    color: var(--mira-text-soft);
    position: relative;
}

.content-article ul li::marker { color: var(--mira-primary); }
.content-article ol { counter-reset: item; }
.content-article ol li { list-style: none; }
.content-article ol li::before {
    counter-increment: item;
    content: counter(item) ".";
    color: var(--mira-primary);
    font-weight: 600;
    margin-right: 0.75rem;
}

.content-article ul ul,
.content-article ol ol,
.content-article ul ol,
.content-article ol ul {
    margin: 0.5rem 0 0.5rem 1.5rem;
}

.content-article blockquote {
    margin: 1.5rem 0;
    padding: 1.25rem 1.5rem;
    border-left: 4px solid var(--mira-primary);
    background: rgba(255, 144, 77, 0.08);
    border-radius: 0 8px 8px 0;
    font-style: italic;
    color: var(--mira-text);
    position: relative;
}

.content-article blockquote::before {
    content: """;
    font-size: 4rem;
    color: var(--mira-primary);
    opacity: 0.15;
    position: absolute;
    top: -0.5rem;
    left: 1rem;
    font-family: Georgia, serif;
    line-height: 1;
    z-index: 0;
}

.content-article blockquote p {
    margin: 0;
    line-height: 1.7;
    position: relative;
    z-index: 1;
}

.content-article blockquote cite {
    display: block;
    margin-top: 1rem;
    font-style: normal;
    font-size: 0.875rem;
    color: var(--mira-text-softer);
}

.content-article hr {
    border: none;
    border-top: 1px solid var(--mira-card-border);
    margin: 3rem 0;
}

.content-article table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9rem;
}

.content-article th,
.content-article td {
    padding: 0.75rem 1rem;
    border: 1px solid var(--mira-card-border);
    text-align: left;
}

.content-article th {
    background: var(--mira-card-bg);
    font-weight: 600;
    color: var(--mira-primary);
}

.content-article tr:nth-child(even) td {
    background: rgba(255, 255, 255, 0.02);
}

.content-article code {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.875em;
    background: var(--mira-pill-bg);
    padding: 0.2em 0.4em;
    border-radius: 4px;
    color: var(--mira-accent-2);
}

.content-article pre {
    background: #0a0a0a;
    border: 1px solid var(--mira-card-border);
    border-radius: 8px;
    padding: 1.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
}

.content-article pre code {
    background: none;
    padding: 0;
    color: var(--mira-text);
    font-size: 0.875rem;
    line-height: 1.6;
}

.content-article img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
}

/* ===== COMPONENTES VISUAIS (do slide) ===== */

/* Content Cards - para destacar conceitos-chave */
.content-card {
    background: var(--mira-card-bg);
    backdrop-filter: blur(10px);
    border: 1px solid var(--mira-card-border);
    border-radius: 12px;
    padding: 1.5rem;
    margin: 1.5rem 0;
    transition: all 0.3s ease;
}

.content-card:hover {
    border-color: var(--mira-primary);
    box-shadow: 0 10px 30px var(--mira-glow-soft);
    transform: translateY(-2px);
}

.content-card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
}

.content-card-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--mira-icon-bg);
    border: 1px solid var(--mira-icon-border);
    color: var(--mira-primary);
}

.content-card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--mira-text);
}

.content-card-text {
    color: var(--mira-text-soft);
    line-height: 1.7;
    margin: 0;
}

/* Dica/Callout boxes */
.callout {
    border-left: 4px solid;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    border-radius: 0 8px 8px 0;
    background: var(--mira-card-bg);
}

.callout-tip { border-color: var(--mira-crop); }
.callout-tip::before { content: "💡 "; color: var(--mira-crop); font-weight: bold; }

.callout-warning { border-color: var(--mira-accent-2); }
.callout-warning::before { content: "⚠️ "; color: var(--mira-accent-2); font-weight: bold; }

.callout-danger { border-color: #FF4D4D; }
.callout-danger::before { content: "🚫 "; color: #FF4D4D; font-weight: bold; }

.callout-info { border-color: var(--mira-primary); }
.callout-info::before { content: "📌 "; color: var(--mira-primary); font-weight: bold; }

.callout-title {
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--mira-text);
}

.callout-text { color: var(--mira-text-soft); line-height: 1.7; margin: 0; }

/* Example boxes */
.example-box {
    background: var(--mira-card-bg);
    border: 1px solid var(--mira-card-border);
    border-radius: 12px;
    padding: 1.5rem;
    margin: 1.5rem 0;
    position: relative;
}

.example-box::before {
    content: "Exemplo";
    position: absolute;
    top: -0.75rem;
    left: 1.5rem;
    background: var(--mira-bg);
    padding: 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--mira-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.example-content { color: var(--mira-text-soft); line-height: 1.7; }
.example-content blockquote { margin: 0; border: none; padding: 0; background: none; }
.example-content blockquote p { font-style: italic; color: var(--mira-text); margin: 0; }

/* Attribute pills inline */
.content-pills { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0; }
.content-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.875rem;
    background: var(--mira-pill-bg);
    border: 1px solid var(--mira-pill-border);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--mira-text-soft);
    transition: all 0.25s ease;
}
.content-pill:hover { background: var(--mira-icon-bg); border-color: var(--mira-icon-border); color: var(--mira-primary); }

/* Section divider with icon */
.section-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 3rem 0 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--mira-card-border);
}

.section-divider-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--mira-icon-bg);
    border: 1px solid var(--mira-icon-border);
    color: var(--mira-primary);
    flex-shrink: 0;
}

.section-divider-line { flex: 1; height: 1px; background: linear-gradient(90deg, var(--mira-card-border), transparent); }

/* ===== COMPONENTES BASE ===== */
.glass-card {
    background: var(--mira-card-bg);
    backdrop-filter: blur(10px);
    border: 1px solid var(--mira-card-border);
    box-shadow: 0 10px 30px var(--mira-glow-soft);
    transition: all 0.3s ease;
    border-radius: 0.75rem;
    padding: 1.5rem;
}

.glass-card:hover { transform: translateY(-4px); box-shadow: 0 20px 40px var(--mira-glow-strong); }

.primary-color { color: var(--mira-primary); }
.primary-bg { background: var(--mira-primary); color: var(--mira-bg); }
.text-soft { color: var(--mira-text-soft); }
.text-softer { color: var(--mira-text-softer); }

.container { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; }

.header {
    border-bottom: 1px solid var(--mira-card-border);
    padding: 1.5rem 0;
    margin-bottom: 2rem;
}

.header-content { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }

.logo { font-size: 1.5rem; font-weight: 700; color: var(--mira-text); }
.logo span { color: var(--mira-primary); }

.nav-links { display: flex; gap: 2rem; }
.nav-links a { color: var(--mira-text-soft); font-weight: 500; }
.nav-links a:hover, .nav-links a.active { color: var(--mira-primary); }

.section-title {
    font-size: 2rem; font-weight: 700; margin-bottom: 1.5rem;
    background: linear-gradient(90deg, var(--mira-primary), var(--mira-accent-2));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}

.card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; }

.btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; border-radius: 9999px; font-weight: 600; transition: all 0.25s ease; border: none; cursor: pointer; }
.btn-primary { background: var(--mira-primary); color: var(--mira-bg); }
.btn-primary:hover { background: var(--mira-accent-2); transform: translateY(-2px); box-shadow: 0 10px 20px var(--mira-glow-strong); }
.btn-outline { background: transparent; border: 1px solid var(--mira-card-border); color: var(--mira-text); }
.btn-outline:hover { border-color: var(--mira-primary); background: var(--mira-icon-bg); }

.footer { border-top: 1px solid var(--mira-card-border); padding: 2rem 0; margin-top: 4rem; text-align: center; color: var(--mira-text-softer); font-size: 0.875rem; }

.icon-hero { width: 48px; height: 48px; border-radius: 14px; display: flex; flex: 0 0 auto; align-items: center; justify-content: center; background: var(--mira-icon-bg); border: 1px solid var(--mira-icon-border); }

.attribute-pill { display: inline-flex; align-items: center; padding: 0.375rem 0.875rem; background: var(--mira-pill-bg); border: 1px solid var(--mira-pill-border); border-radius: 9999px; font-size: 0.75rem; font-weight: 500; color: var(--mira-text-soft); transition: all 0.25s ease; }
.attribute-pill:hover { background: var(--mira-icon-bg); border-color: var(--mira-icon-border); color: var(--mira-primary); transform: translateY(-2px); }

@media (max-width: 768px) {
    .container { padding: 1rem; }
    .nav-links { gap: 1rem; }
    .section-title { font-size: 1.5rem; }
    article.glass-card, .content-article { padding: 1.5rem; }
    .content-article h1 { font-size: 2rem; }
    .content-article h2 { font-size: 1.5rem; }
    .content-article h3 { font-size: 1.15rem; }
}